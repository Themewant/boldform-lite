<?xml version="1.0"?>
<ruleset name="BoldForm Lite">
	<description>WordPress Coding Standards for BoldForm Lite.</description>

	<!--
		Scope. Only the directories that actually ship (mirror package.json "files").
		includes/appsero is a vendored third-party SDK: it is not ours to restyle, and
		it is the sole source of this plugin's Plugin Check errors.
	-->
	<file>admin</file>
	<file>includes</file>
	<file>public</file>
	<file>blocks</file>
	<file>boldform-lite.php</file>
	<file>uninstall.php</file>

	<exclude-pattern>*/includes/appsero/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/assets/js/flatpickr.min.js</exclude-pattern>

	<!-- Mirror the plugin header exactly: this decides deprecated-function error vs warning. -->
	<config name="minimum_wp_version" value="6.3"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="boldform-lite"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="boldform"/>
				<element value="BoldForm"/>
				<element value="BOLDFORM"/>
			</property>
		</properties>
	</rule>

	<arg value="ps"/>
	<arg name="extensions" value="php"/>
	<arg name="colors"/>
</ruleset>
